# Environment Variables for EduManage

# PostgreSQL Connection URL
# Example for local PostgreSQL: postgresql://postgres:password@localhost:5432/edumanage?schema=public
# Example for Supabase/Neon: postgresql://username:password@ep-cool-db.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://postgres:password@localhost:5432/edumanage?schema=public"

# Direct URL for migrations (if using connection pooler like Supabase/Neon)
DIRECT_URL="postgresql://postgres:password@localhost:5432/edumanage?schema=public"


# Authentication secret for JWT tokens
AUTH_SECRET="edumanage_super_secret_jwt_key_change_in_production_2026"

# Next.js App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
